---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "@/components/header";
import Footer from "@/components/footer.astro";
import { Content } from "../content/terms.md";
---

<BaseLayout
  title="Termos e Condições | Inês Neves Caldas"
  url="https://inesnevescaldas.pt/termos"
  description="Termos e Condições de utilização do site e serviços da PSINC – Serviços Clínicos LDA."
>
  <div class="min-h-screen bg-bg text-text flex flex-col">
    <Header
      links={["Sobre mim", "Atividade", "Media", "Marcar consulta"]}
      client:load
    />
    <main class="container mx-auto px-6 py-12 max-w-3xl flex-1">
      <article class="prose prose-stone max-w-none">
        <Content />
      </article>
    </main>
    <Footer />
  </div>
</BaseLayout>
